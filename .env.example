# --- Required in production ---
# JWT_SECRET signs session tokens. Generate with: openssl rand -hex 48
JWT_SECRET=dev-only-secret-change-me-in-production-please-0123456789
# Independent, rotation-capable application-data keys. First entry encrypts;
# keep older entries after it until stored OAuth tokens have been rewritten.
# Generate each secret with: openssl rand -hex 32
DATA_ENCRYPTION_KEYS=v1:replace-with-at-least-32-random-characters

# Public URL of the SPA. Used in invite/RSVP/email links.
FRONTEND_BASE_URL=http://localhost:5173

# --- Optional in dev, recommended in prod ---
# Resend (transactional email). When unset, links are logged to stdout.
RESEND_API_KEY=
EMAIL_FROM="Weddly <noreply@example.com>"
SUPPORT_EMAIL=hello@example.com
# Explicit production admin allowlist. Production refuses to boot when absent.
ADMIN_EMAILS=admin@example.com

# Sentry (error reporting). When unset, capture is a no-op.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Optional: 0..1, how many spans to send. Default 0 (no tracing).
SENTRY_TRACES_SAMPLE_RATE=0

# Structured-log threshold: debug | info | warn | error. Default info.
LOG_LEVEL=info

# Plausible (cookieless analytics). Build-time — rebuild required to change.
VITE_PLAUSIBLE_DOMAIN=

# Google Tag Manager container id (e.g. GTM-K9NCXCL9). Runtime env, read per
# request by the SSR head builder — no rebuild needed. Empty/unset = no GTM
# injected (dev + tests stay analytics-free).
GTM_CONTAINER_ID=

# Direct GA4 measurement id (e.g. G-XXXXXXXXXX). Runtime env, no rebuild needed.
# When set, injects gtag.js + config call directly — bypasses the GTM container.
# Use this when the GTM container does NOT have its own GA4 Configuration tag.
# Remove this var if you later add a GA4 tag inside GTM to avoid double-counting.
# Get the measurement id from GA4 Admin > Data Streams > stream detail.
GA4_MEASUREMENT_ID=

# GA4 Data API → admin Traffic section. Pulls live visitor/session numbers
# into /app/admin/analytics. Both must be set or the section shows a setup
# card. GA4_PROPERTY_ID is the NUMERIC property id (Admin → Property settings,
# e.g. 493210114), NOT the "G-…" measurement id. GA4_SERVICE_ACCOUNT_JSON is a
# Google Cloud service-account key (full JSON, single line) whose email is
# added as a Viewer on the GA4 property.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Multi-host SEO (e.g. weddly.com as a separate EN canonical alongside the HU
# weddly.hu apex). When SET, the SSR pairs hu/en hreflang link rels across
# the two hosts, visiting the EN host forces locale="en" regardless of
# Accept-Language, and the sitemap pairs URLs across both hosts. When
# UNSET, the codebase stays single-host (status-quo behaviour).
# VITE_EN_CANONICAL_HOST is baked at build time — rebuild required to flip.
# Both must be set together (or both unset) to keep client + SSR aligned.
EN_CANONICAL_HOST=
VITE_EN_CANONICAL_HOST=

# Google "Sign in / Sign up with Google" (Google Identity Services).
# Web-client id from console.cloud.google.com → APIs & Services → Credentials.
# Required for /api/auth/google to verify ID tokens; when empty the endpoint
# returns 503 and the frontend button hides itself.
# VITE_GOOGLE_CLIENT_ID is baked at build time — rebuild required to change.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple. The Services ID must match on backend and frontend; the
# redirect URI must be registered as an Apple Return URL.
APPLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=

# Google Calendar OAuth (uses GOOGLE_CLIENT_ID as its client id).
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_UNVERIFIED=0

# Cloudflare R2 object storage and automatic SQLite snapshots.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BACKUP_BUCKET=
R2_BACKUP_INTERVAL_HOURS=24
R2_BACKUP_RETENTION=14

# Optional integrations. Empty keeps the corresponding feature disabled.
ANTHROPIC_API_KEY=
DEEPL_API_KEY=
SERPAPI_KEY=
GOOGLE_PLACES_API_KEY=
MAXMIND_LICENSE_KEY=
GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# Company lookup (business-registry auto-fill in planner onboarding/settings).
# France, Netherlands, Hungary and Belgium need no credentials. Greece (GEMI
# Open Data API) needs a free key granted by the GEMI Authority: register at
# https://opendata.businessportal.gr/register/ . Empty = Greece falls back to
# manual entry; everything else keeps working.
GEMI_API_KEY=

# --- Local paths (dev defaults) ---
PORT=8787
DB_PATH=./data/weddly.db
UPLOADS_DIR=./data/uploads

# --- Stripe payments (each product is launched separately from Admin) ---
# A secret key alone does not make a product launch-ready. The matching
# webhook secret and every price id for that product must also be present.
# Keep this at 0 until the operator is registered and counsel/accountant have
# approved the paid terms, checkout disclosures, invoicing, tax and VAT setup.
# Production payment activation remains fail-closed unless it is exactly 1.
LEGAL_PAID_LAUNCH_APPROVED=0
STRIPE_SECRET_KEY=

# Couple subscription + the webhook that also fulfils film/add-on checkouts.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EUR=
STRIPE_PRICE_HUF=

# Planner-managed couple guest-page add-on (one-time prices).
STRIPE_GUEST_PAGE_ADDON_PRICE_EUR=
STRIPE_GUEST_PAGE_ADDON_PRICE_HUF=

# Planner subscriptions (three monthly tiers, two billing currencies).
STRIPE_PLANNER_WEBHOOK_SECRET=
STRIPE_PRICE_PLANNER_STARTER_EUR=
STRIPE_PRICE_PLANNER_STARTER_HUF=
STRIPE_PRICE_PLANNER_PRO_EUR=
STRIPE_PRICE_PLANNER_PRO_HUF=
STRIPE_PRICE_PLANNER_PREMIUM_EUR=
STRIPE_PRICE_PLANNER_PREMIUM_HUF=

# Vendor subscription + setup/deferred-subscription flow.
STRIPE_VENDOR_WEBHOOK_SECRET=
STRIPE_PRICE_VENDOR_EUR=
STRIPE_PRICE_VENDOR_HUF=
