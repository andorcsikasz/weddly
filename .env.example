# --- Required in production ---
# JWT_SECRET signs session tokens. Generate with: openssl rand -hex 48
JWT_SECRET=dev-only-secret-change-me-in-production-please-0123456789

# Public URL of the SPA. Used in invite/RSVP/email links.
FRONTEND_BASE_URL=http://localhost:5173

# --- Optional in dev, recommended in prod ---
# Resend (transactional email). When unset, links are logged to stdout.
RESEND_API_KEY=
EMAIL_FROM="Weddly <noreply@example.com>"

# Sentry (error reporting). When unset, capture is a no-op.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Optional: 0..1, how many spans to send. Default 0 (no tracing).
SENTRY_TRACES_SAMPLE_RATE=0

# Structured-log threshold: debug | info | warn | error. Default info.
LOG_LEVEL=info

# Plausible (cookieless analytics). Build-time — rebuild required to change.
VITE_PLAUSIBLE_DOMAIN=

# Google Tag Manager container id (e.g. GTM-K9NCXCL9). Runtime env, read per
# request by the SSR head builder — no rebuild needed. Empty/unset = no GTM
# injected (dev + tests stay analytics-free). The GA4 measurement id
# (G-…) is configured inside the GTM web UI, not here.
GTM_CONTAINER_ID=

# GA4 Data API → admin Traffic section. Pulls live visitor/session numbers
# into /app/admin/analytics. Both must be set or the section shows a setup
# card. GA4_PROPERTY_ID is the NUMERIC property id (Admin → Property settings,
# e.g. 493210114), NOT the "G-…" measurement id. GA4_SERVICE_ACCOUNT_JSON is a
# Google Cloud service-account key (full JSON, single line) whose email is
# added as a Viewer on the GA4 property.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Multi-host SEO (e.g. weddly.com as a separate EN canonical alongside the HU
# weddly.hu apex). When SET, the SSR pairs hu/en hreflang link rels across
# the two hosts, visiting the EN host forces locale="en" regardless of
# Accept-Language, and the sitemap pairs URLs across both hosts. When
# UNSET, the codebase stays single-host (status-quo behaviour).
# VITE_EN_CANONICAL_HOST is baked at build time — rebuild required to flip.
# Both must be set together (or both unset) to keep client + SSR aligned.
EN_CANONICAL_HOST=
VITE_EN_CANONICAL_HOST=

# Google "Sign in / Sign up with Google" (Google Identity Services).
# Web-client id from console.cloud.google.com → APIs & Services → Credentials.
# Required for /api/auth/google to verify ID tokens; when empty the endpoint
# returns 503 and the frontend button hides itself.
# VITE_GOOGLE_CLIENT_ID is baked at build time — rebuild required to change.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Local paths (dev defaults) ---
PORT=8787
DB_PATH=./data/weddly.db
UPLOADS_DIR=./data/uploads

# --- Stripe (v2 marketplace; deferred) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
