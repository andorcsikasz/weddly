{
  "name": "weddly",
  "private": true,
  "version": "0.0.1",
  "workspaces": ["backend", "frontend"],
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "postcss-selector-parser": "6.1.3"
  },
  "scripts": {
    "start": "cd backend && bun src/server.ts",
    "dev": "bun run dev:backend & bun run dev:frontend",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "cd frontend && bun run build",
    "build:frontend": "cd frontend && bun run build",
    "check:bundle": "bun scripts/check-bundle-budget.ts",
    "check:migrations": "bun scripts/check-db-migrations.ts",
    "preflight:stripe": "bun backend/scripts/stripe_preflight.ts",
    "typecheck": "cd backend && bun run typecheck && cd ../frontend && bun run typecheck",
    "test": "cd backend && bun run test && cd ../frontend && bun run test",
    "lint": "biome check .",
    "validate:seo": "bun scripts/validate-seo.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
