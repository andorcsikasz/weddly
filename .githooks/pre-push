#!/usr/bin/env bash
# Pre-push: full gate against HEAD — exactly what git is about to ship.
#
# We extract HEAD into a tempdir via `git archive | tar -x` and run the checks
# there. NEVER `git stash` — stash rewrites the working tree, racing with any
# other agent / editor that may be touching files.
#
# Enable once per clone with:  bun run setup:hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Git supplies the remote's current SHA on stdin. Keep the oldest relevant
# production shape so a multi-commit push cannot hide an unsafe migration in
# an earlier commit behind a later, schema-neutral commit.
REMOTE_BASE=""
ZERO_SHA="0000000000000000000000000000000000000000"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [[ "$local_sha" = "$(git rev-parse HEAD)" && "$remote_sha" != "$ZERO_SHA" ]]; then
    REMOTE_BASE="$remote_sha"
  fi
done

step() { printf "\033[1;34m▶ %s\033[0m\n" "$1"; }
ok()   { printf "\033[1;32m✓ %s\033[0m\n" "$1"; }
die()  { printf "\033[1;31m✗ %s\033[0m\n" "$1" >&2; exit 1; }

ROOT="$PWD"
TMP="$(mktemp -d -t weddly-prepush-XXXXXXXX)"
cleanup() { rm -rf "$TMP" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

step "Extracting HEAD snapshot to $TMP"
git archive --format=tar HEAD | tar -x -C "$TMP"

if [[ -n "$REMOTE_BASE" ]] && git cat-file -e "$REMOTE_BASE^{commit}" 2>/dev/null; then
  git show "$REMOTE_BASE:backend/src/schema.sql" > "$TMP/.migration-base-schema.sql"
else
  git show "HEAD^:backend/src/schema.sql" > "$TMP/.migration-base-schema.sql"
fi

# Symlink node_modules to skip the install. Source files come from HEAD; deps
# only matter for resolution.
link_modules() {
  local sub="$1"
  local src dst
  if [[ -z "$sub" ]]; then src="$ROOT/node_modules";       dst="$TMP/node_modules"
  else                     src="$ROOT/$sub/node_modules";  dst="$TMP/$sub/node_modules"
  fi
  [[ -d "$src" && ! -e "$dst" ]] && ln -s "$src" "$dst" 2>/dev/null || true
}
link_modules ""
link_modules "backend"
link_modules "frontend"

# Random high port so parallel pushes / dev servers don't clash.
TEST_PORT=$(( 18000 + RANDOM % 10000 ))
export PORT="$TEST_PORT"
export BUN_TEST_PORT="$TEST_PORT"
export BUN_TEST_DB_PATH="$TMP/data/prepush-test-weddly.db"
export BUN_TEST_UPLOADS_DIR="$TMP/data/prepush-test-uploads"

cd "$TMP"

step "SQLite migration safety (previous schema → current, two boots)"
bun scripts/check-db-migrations.ts \
  --base-schema "$TMP/.migration-base-schema.sql" || die "database migration safety failed"
ok "database migrations"

step "Biome"
bunx --bun biome check . || die "biome failed"
ok "biome"

step "Typecheck (backend)"
( cd backend  && bun tsc --noEmit ) || die "backend typecheck failed"
ok "backend typecheck"

step "Typecheck (frontend)"
( cd frontend && bun tsc -b --noEmit ) || die "frontend typecheck failed"
ok "frontend typecheck"

# Vite build catches PostCSS/Tailwind @apply errors that tsc can't see.
step "Frontend build (Vite + Tailwind @apply resolution)"
( cd frontend && bun run build ) || die "frontend build failed"
ok "frontend build"

step "E2E tests (port $TEST_PORT)"
( cd backend && bun test tests/e2e.test.ts ) || die "E2E failed"
ok "all green — pushing"
