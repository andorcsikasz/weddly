{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "backend/**",
      "frontend/**",
      "shared/**",
      "Dockerfile",
      "package.json",
      "bun.lock"
    ]
  },
  "deploy": {
    "startCommand": "bun src/server.ts",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
